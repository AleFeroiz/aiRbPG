@startuml
skinparam classAttributeIconSize 0
class Cliente {
  +id: int
  +nome: string
  +contato: string
  +ativo: bool
}
class Usuario {
  +id: int
  +login: string
  +perfil: PerfilUsuario
  +ativo: bool
}
class Espaco {
  +id: int
  +capacidade: int
  +tarifaHora: decimal
  +tarifaPessoa: decimal
}
class Reserva {
  +id: int
  +inicio: DateTime
  +fim: DateTime
  +pessoas: int
  +status: StatusReserva
  +total: decimal
  +multas: decimal
  +desconto: decimal
}
class Acessorio {
  +id: int
  +nome: string
  +estoque: int
  +tarifaHora: decimal
}
class ItemReserva {
  +id: int
  +reservados: int
  +retirados: int
  +devolvidos: int
  +danos: int
  +perdas: int
}
class Pagamento {
  +id: int
  +dataHora: DateTime
  +valor: decimal
  +metodo: string
}
class HistoricoReserva {
  +id: int
  +dataHora: DateTime
  +acao: string
  +observacao: string
}
Cliente "1" -- "0..*" Reserva
Usuario "1" -- "0..*" Reserva
Espaco "1" -- "0..*" Reserva
Reserva "1" *-- "0..*" ItemReserva
Acessorio "1" -- "0..*" ItemReserva
Reserva "1" *-- "0..*" Pagamento
Reserva "1" *-- "0..*" HistoricoReserva
Usuario "1" -- "0..*" HistoricoReserva
@enduml
